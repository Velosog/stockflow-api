# Copy to .env and adjust. Never commit .env.
# Values below are placeholders for local development only.

APP_NAME=StockFlow
APP_ENV=local
# Generate with: php artisan key:generate (or the docker command in README)
APP_KEY=
# MUST be false in production: debug pages leak config and stack traces.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use "info" or higher in production.
LOG_LEVEL=debug

# PostgreSQL. docker-compose reads DB_DATABASE, DB_USERNAME and DB_PASSWORD
# from this file to create the database container.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stockflow
DB_USERNAME=stockflow
DB_PASSWORD=change-me-local-only
# Host port that docker-compose exposes for PostgreSQL.
FORWARD_DB_PORT=5432
# Host port that docker-compose exposes for the API.
FORWARD_APP_PORT=8000

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@stockflow.test"
MAIL_FROM_NAME="${APP_NAME}"

# API tokens (Laravel Sanctum). Minutes until a token expires.
SANCTUM_TOKEN_EXPIRATION=1440
# Prefix added to issued tokens so secret scanners can recognise leaks.
SANCTUM_TOKEN_PREFIX=sf_

# Rate limits (requests per minute).
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30

# How long an Idempotency-Key is remembered for POST /orders.
IDEMPOTENCY_KEY_TTL_HOURS=24
